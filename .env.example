AWS_REGION=ap-southeast-1

# Local database credentials (used instead of AWS Secrets Manager)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=iotdb
DB_USER=iot_user
DB_PASSWORD=local_password

# Any app-level secrets (rotate for production)
JWT_SECRET=dev_jwt_secret_change_me

# Frontend config
VITE_API_BASE_URL=http://localhost:3001

# If you later add IoT device simulators, point them to the local MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883

# Backend server config
AVAILABILITY_SERVICE_PORT=5000